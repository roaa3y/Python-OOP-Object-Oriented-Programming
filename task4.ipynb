        "class point:\n",
        "  x=0\n",
        "  y=0\n",
        "  def translate(self,dx,dy):\n",
        "    self.x +=dx\n",
        "    self.y +=dy\n",
        "    p1=point()\n",
        "    p1.translate(4,3)\n",
        "    print(p1.x)\n",
        "    print(p1.y)"
      ]
    }
  ]
